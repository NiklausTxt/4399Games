{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dontpanic42-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/wechat", "/wechat/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dontpanic42-db",
      "database_id": "2faef611-83ff-4b28-854a-33a4aa0bda5d"
    }
  ]
}
